# Postgres container credentials (required)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Runtime settings, passed to api, worker and scheduler. Each line shows the default.
# Uncomment a line to override it. DATABASE_URL and REDIS_URL are set in
# docker-compose.yml for the containers, so setting them here has no effect there.
# DATABASE_URL=
# REDIS_URL=
# LEASE_SECONDS=30
# HEARTBEAT_SECONDS=10
# POP_TIMEOUT_SECONDS=2
# STALL_SECONDS=60
# BACKOFF_SECONDS=30,120
# JOB_TIMEOUTS=email:10,webhook:10,report:15
# RELAY_INTERVAL_SECONDS=1
# REAPER_INTERVAL_SECONDS=5
# IDEMPOTENCY_CLEANUP_SECONDS=300
# IDEMPOTENCY_TTL_HOURS=24
# JOB_SLEEP_SCALE=1.0
# WEBHOOK_FAILURE_RATE=0.2
# LOG_LEVEL=INFO
